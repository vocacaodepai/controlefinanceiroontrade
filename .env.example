# Banco de produção (Supabase → Project Settings → Database → Connection string → "Transaction pooler").
# Sem esta variável, o sistema usa um Postgres local embutido (data/pg) — só para desenvolvimento.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opcional, recomendado em produção: código exigido para criar o primeiro administrador.
SETUP_TOKEN=troque-por-um-codigo-secreto
